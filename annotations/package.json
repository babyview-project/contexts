{
    "name": "activity-annotation-server",
    "version": "1.0.0",
    "description": "Activity annotation website (doing/seeing) for headcam videos",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node server.js --dev",
        "test-site": "node server.js --test --dev",
        "test-site:prod-flow": "node server.js --test",
        "users": "node scripts/users.js",
        "test-site:accounts": "AUTH_MODE=accounts USERS_PATH=users.json node server.js --test --dev"
    },
    "keywords": [
        "annotation",
        "video",
        "jspsych",
        "research"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "connect-mongo": "^5.1.0",
        "cors": "^2.8.5",
        "csv-parser": "^3.0.0",
        "csv-writer": "^1.6.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-session": "^1.17.3",
        "mongoose": "^8.0.3"
    },
    "devDependencies": {}
}
